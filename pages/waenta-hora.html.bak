                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }

        // 5. Render ยามตรีเนตร์ & ยาม 3 ตา
        function renderYarmTab() {
            const timeVal = document.getElementById('birthTime').value || "12:00";
            const [h, m] = timeVal.split(':').map(Number);
            const yarm = WaentaHoraEngine.calculateYarmTriNetr(h, m);

            const card = document.getElementById('yarmContentCard');
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                    <h3 style="color: #fff3b0; font-weight: 700; margin: 0;">
                        👁️ การพยากรณ์ยามตรีเนตร์ & ยาม ๓ ตา (เวลา ${yarm.timeStr} น.)
                    </h3>
                    <span class="badge badge-info px-3 py-2">ยามที่ ${yarm.yarmSlot} (นับจากย่ำรุ่ง ๐๖:๐๐)</span>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6 mb-2">
                        <div class="p-3" style="background: rgba(56, 189, 248, 0.12); border: 1.5px solid #38bdf8; border-radius: 14px;">
                            <div style="font-size: 0.9rem; color: #bae6fd;">ตำแหน่งยามตรีเนตร์:</div>
                            <h2 style="color: #38bdf8; font-weight: 700; margin: 6px 0;">✨ ยาม "${yarm.triNetr}"</h2>
                            <div class="mt-2" style="font-size: 0.9rem; color: #f8fafc;">
                                <div><strong>ลักษณะบุคคลที่ทาย:</strong> ${yarm.netrDetail.person}</div>
                                <div class="mt-1"><strong>เรื่องความรัก/ผู้ใหญ่:</strong> ${yarm.netrDetail.love}</div>
                                <div class="mt-1"><strong>เรื่องคนไข้/สุขภาพ:</strong> ${yarm.netrDetail.illness}</div>
                                <div class="mt-1"><strong>เรื่องของหาย:</strong> ${yarm.netrDetail.lostItem}</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-2">
                        <div class="p-3" style="background: rgba(168, 85, 247, 0.12); border: 1.5px solid #a855f7; border-radius: 14px;">
                            <div style="font-size: 0.9rem; color: #e9d5ff;">การพยากรณ์ยาม ๓ ตา:</div>
                            <h2 style="color: #c084fc; font-weight: 700; margin: 6px 0;">🎯 ${yarm.samTaText.split(':')[0]}</h2>
                            <div class="mt-2" style="font-size: 0.95rem; color: #f8fafc; line-height: 1.6;">
                                ${yarm.samTaText}<br>
                                <small style="color: #cbd5e1;">(สูตร: นำเลขยาม ${yarm.yarmSlot} × ๒ เอา ๓ หาร พิจารณาเศษ)</small>
                            </div>
                        </div>
                    </div>
                </div>

                <h4 style="color: #fde047; font-weight: 600; margin-top: 15px; margin-bottom: 10px;"><i class="fas fa-info-circle"></i> ความหมายยามตรีเนตร์ทั้ง ๓ (ก่ำ / ใส / ปลอด)</h4>
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <div class="info-pill" style="border-left: 4px solid #ef4444;">
                            <strong style="color: #f87171;">ก่ำ:</strong> เพศชาย / คนแก่ / ตัวสูงใหญ่ / ผิวดำ / ถามรักท่านรักมาก / คนไข้ร้ายนัก / ของหายได้คืนเร็ว
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="info-pill" style="border-left: 4px solid #38bdf8;">
                            <strong style="color: #38bdf8;">ใส:</strong> บัณฑิต / ไม่แก่ / รูปงาม / ผิวดำแดง / ถามรักรักชังพอประมาณ / คนไข้อาการมาก / ของหายได้คืนช้า
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="info-pill" style="border-left: 4px solid #22c55e;">
                            <strong style="color: #4ade80;">ปลอด:</strong> เพศหญิง / เด็ก / ตัวเตี้ยผอม / ผิวขาวผ่อง / ถามรักไม่ดี / คนไข้หายเร็ว / ของหายสูญไม่ได้คืน
                        </div>
                    </div>
                </div>
            `;
        }

        // 6. Render พิธีสะเดาะเคราะห์ & ฤกษ์มงคล
        function renderRitualTab(dayOfWeek) {
            const data = WAENTA_HORA_DATA.birthDays[dayOfWeek];
            if (!data) return;

            const card = document.getElementById('ritualContentCard');
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                    <h3 style="color: #fff3b0; font-weight: 700; margin: 0;">
                        🕉️ พิธีสะเดาะพระเคราะห์ & คาถามงคลโบราณ (สำหรับผู้เกิด: ${data.dayName})
                    </h3>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-vihara"></i> พระพุทธรูปบูชาสะเดาะเคราะห์</div>
                            <div class="info-desc" style="font-size: 1rem; color: #fde047; font-weight: 600;">${data.sadawkhro.buddhaPosture}</div>
                        </div>
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-leaf"></i> ใบไม้มงคลรองบัด</div>
                            <div class="info-desc">${data.sadawkhro.offeringLeaf}</div>
                        </div>
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-sign-in-alt"></i> ทิศทางเข้า-ออกของพระเคราะห์</div>
                            <div class="info-desc">${data.sadawkhro.remedyDirection}</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-horse"></i> พาหนะและเครื่องทรงเทวดา</div>
                            <div class="info-desc">${data.sadawkhro.vehicle}</div>
                        </div>
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-hourglass-half"></i> กำลังดาวเสวยอายุ</div>
                            <div class="info-desc">${data.sadawkhro.powerYears}</div>
                        </div>
                        <div class="info-pill">
                            <div class="info-title"><i class="fas fa-book-reader"></i> พระคาถาสวดสะเดาะเคราะห์</div>
                            <div class="info-desc" style="color: #a5f3fc;">${data.sadawkhro.chant}</div>
                        </div>
                    </div>
                </div>

                <!-- คาถาบูชาบัดพลีรวม & คาถาเดินทางหาลาภ -->
                <h4 style="color: #fde047; font-weight: 600; margin-top: 20px; margin-bottom: 12px;"><i class="fas fa-om"></i> พระคาถาศักดิ์สิทธิ์ประจำคัมภีร์แว่นตาโหร</h4>
                
                <div class="info-pill mb-3" style="background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(241, 208, 110, 0.4);">
                    <div class="info-title" style="color: #ffd700;"><i class="fas fa-pray"></i> ๑. พระคาถาสวดบูชาบัดพลีรวม (ปัดเป่าเคราะห์ภัยนพเคราะห์ทั้งปวง)</div>
                    <div style="font-size: 0.98rem; line-height: 1.8; color: #fef08a; padding: 8px 0; font-family: 'Sarabun', sans-serif;">
                        "${WAENTA_HORA_DATA.sacredMantras.allPlanetsOffering}"
                    </div>
                </div>

                <div class="info-pill" style="background: rgba(15, 23, 42, 0.9); border: 1.5px solid rgba(56, 189, 248, 0.4);">
                    <div class="info-title" style="color: #38bdf8;"><i class="fas fa-route"></i> ๒. คาถาเสกก่อนเดินทางไปหาลาภ (สวด ๓ จบ)</div>
                    <div style="font-size: 1.05rem; line-height: 1.8; color: #e0f2fe; padding: 6px 0; font-family: 'Sarabun', sans-serif;">
                        "${WAENTA_HORA_DATA.sacredMantras.travelFortune}"
                    </div>
                </div>
            `;
        }

        // เริ่มการทำงานเมื่อโหลดหน้า
        document.addEventListener('DOMContentLoaded', () => {
            checkDiamondTierAccess();
            initMemberPicker();
        });
    </script>
</body>
</html>
